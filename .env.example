# Database connection string (Postgres)
# Local dev-db (scripts/dev-db.mjs):
#   postgres://wishlist:wishlist@127.0.0.1:55432/wishlist
# Neon pooled connection (for application runtime on Vercel):
#   postgresql://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgres://wishlist:wishlist@127.0.0.1:55432/wishlist

# Optional direct unpooled connection (used by Neon for migrations):
#   postgresql://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require
# DATABASE_URL_UNPOOLED=

# Maximum database connection pool size.
# Use 1 for connection-limited targets (Vercel serverless / PGlite dev-db), defaults to 10 otherwise.
DB_POOL_MAX=1
